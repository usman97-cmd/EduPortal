@model List<Student_Mangement_System.Models.Fee>

@{
    ViewData["Title"] = "Fees";
}

<div class="row mb-3">

    <div class="col-sm-6">
        <h3 class="m-0">Fees</h3>
    </div>

    <div class="col-sm-6 text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Fee
        </a>
    </div>

</div>


<div class="card shadow-sm">

    <div class="card-header">
        <h3 class="card-title">
            Fee List
        </h3>
    </div>

    <div class="card-body">

        <table class="table table-bordered table-hover table-striped">

            <thead class="table-dark">

                <tr>

                    <th style="width:80px">
                        ID
                    </th>

                    <th>
                        Student
                    </th>

                    <th>
                        Amount
                    </th>

                    <th>
                        Due Date
                    </th>

                    <th>
                        Paid Date
                    </th>

                    <th>
                        Status
                    </th>

                    <th style="width:120px">
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {
                    @foreach (var fee in Model)
                    {
                        <tr>

                            <td>
                                @fee.Id
                            </td>


                            <td>
                                @fee.Student.FirstName
                                @fee.Student.LastName
                            </td>


                            <td>
                                @fee.Amount.ToString("N2")
                            </td>


                            <td>
                                @fee.DueDate.ToString("dd-MM-yyyy")
                            </td>


                            <td>
                                @if (fee.PaidDate.HasValue)
                                {
                                    @fee.PaidDate.Value.ToString("dd-MM-yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not Paid
                                    </span>
                                }
                            </td>


                            <td>

                                @if (fee.IsPaid)
                                {
                                    <span class="badge bg-success">
                                        Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Unpaid
                                    </span>
                                }

                            </td>


                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@fee.Id"
                                   class="btn btn-warning btn-sm">

                                    <i class="bi bi-pencil-square"></i>

                                </a>


                                <button type="button"
                                        class="btn btn-danger btn-sm delete-btn"
                                        data-id="@fee.Id">

                                    <i class="bi bi-trash"></i>

                                </button>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center text-muted">

                            No Fee Records Found

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
@section Scripts {
    <script>
        const buttons = document.querySelectorAll(".delete-btn");

        buttons.forEach(button => {

            button.addEventListener("click", function (event) {

                event.preventDefault();

                const id = this.dataset.id;

                fetch("/Fee/Delete?id=" + id, {
                    method: "DELETE"
                })
                .then(response => response.json())
                .then(data => {

                    if (data.success) {

                        alert(data.message);

                        this.closest("tr").remove();

                    }
                    else {

                        alert(data.message);

                    }

                })
                .catch(error => {

                    console.log(error);

                    alert("Something went wrong.");

                });

            });

        });
    </script>
}