@model Student_Mangement_System.Models.Fee

@{
    ViewData["Title"] = "Edit Fee";
}

<div class="row mb-3">

    <div class="col-sm-6">
        <h3 class="m-0">Edit Fee</h3>
    </div>

    <div class="col-sm-6 text-end">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

</div>


<div class="card shadow-sm">

    <div class="card-header">
        <h3 class="card-title">
            Edit Fee Information
        </h3>
    </div>

    <div class="card-body">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- Student -->

            <div class="mb-3">

                <label asp-for="StudentId"
                       class="form-label">
                    Student
                </label>

                <select asp-for="StudentId"
                        class="form-select"
                        asp-items="ViewBag.Students">

                    <option value="">
                        -- Select Student --
                    </option>

                </select>

                <span asp-validation-for="StudentId"
                      class="text-danger">
                </span>

            </div>


            <!-- Amount -->

            <div class="mb-3">

                <label asp-for="Amount"
                       class="form-label">
                    Amount
                </label>

                <input asp-for="Amount"
                       class="form-control"
                       type="number"
                       step="0.01"
                       placeholder="Enter fee amount" />

                <span asp-validation-for="Amount"
                      class="text-danger">
                </span>

            </div>


            <!-- Due Date -->

            <div class="mb-3">

                <label asp-for="DueDate"
                       class="form-label">
                    Due Date
                </label>

                <input asp-for="DueDate"
                       class="form-control"
                       type="date" />

                <span asp-validation-for="DueDate"
                      class="text-danger">
                </span>

            </div>


            <!-- Paid Date -->

            <div class="mb-3">

                <label asp-for="PaidDate"
                       class="form-label">
                    Paid Date
                </label>

                <input asp-for="PaidDate"
                       class="form-control"
                       type="date" />

                <span asp-validation-for="PaidDate"
                      class="text-danger">
                </span>

            </div>


            <!-- Is Paid -->

            <div class="mb-3 form-check">

                <input asp-for="IsPaid"
                       class="form-check-input"
                       type="checkbox" />

                <label asp-for="IsPaid"
                       class="form-check-label">
                    Fee Paid
                </label>

            </div>


            <div class="text-end">

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-circle"></i>
                    Update Fee

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}