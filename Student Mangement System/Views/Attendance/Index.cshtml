@model List<Student_Mangement_System.Models.Attendance>

@{
    ViewData["Title"] = "Attendance";
}

<div class="row mb-3">

    <div class="col-sm-6">
        <h3 class="m-0">Attendance</h3>
    </div>

    <div class="col-sm-6 text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Mark Attendance
        </a>
    </div>

</div>

<div class="card shadow-sm">

    <div class="card-header">
        <h3 class="card-title">
            Attendance List
        </h3>
    </div>

    <div class="card-body">

        <table class="table table-bordered table-hover table-striped">

            <thead class="table-dark">

                <tr>
                    <th style="width:80px">ID</th>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Attendance Date</th>
                    <th>Status</th>
                    <th style="width:120px">Actions</th>
                </tr>

            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    @foreach (var attendance in Model)
                    {
                        <tr>

                            <td>
                                @attendance.Id
                            </td>

                            <td>
                                @attendance.Student.FirstName
                                @attendance.Student.LastName
                            </td>

                            <td>
                                @attendance.Course.CourseName
                            </td>

                            <td>
                                @attendance.AttendanceDate.ToString("dd-MM-yyyy")
                            </td>

                            <td>
                                @if (attendance.IsPresent)
                                {
                                    <span class="badge bg-success">
                                        Present
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Absent
                                    </span>
                                }
                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@attendance.Id"
                                   class="btn btn-warning btn-sm">

                                    <i class="bi bi-pencil-square"></i>

                                </a>

                                <button type="button"
                                        class="btn btn-danger btn-sm delete-btn"
                                        data-id="@attendance.Id">

                                    <i class="bi bi-trash"></i>

                                </button>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="6"
                            class="text-center text-muted">

                            No Attendance Records Found

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>