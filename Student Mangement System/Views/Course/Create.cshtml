@model Student_Mangement_System.Models.Course

@{
    ViewData["Title"] = "Create Course";
}

<div class="row mb-3">

    <div class="col-sm-6">
        <h3 class="m-0">Create Course</h3>
    </div>

    <div class="col-sm-6 text-end">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

</div>

<div class="card shadow-sm">

    <div class="card-header">
        <h3 class="card-title">Course Information</h3>
    </div>

    <div class="card-body">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- Course Name -->
            <div class="mb-3">

                <label asp-for="CourseName" class="form-label">
                    Course Name
                </label>

                <input asp-for="CourseName"
                       class="form-control"
                       placeholder="Enter course name" />

                <span asp-validation-for="CourseName"
                      class="text-danger">
                </span>

            </div>

            <!-- Credit Hours -->
            <div class="mb-3">

                <label asp-for="CreditHours" class="form-label">
                    Credit Hours
                </label>

                <input asp-for="CreditHours"
                       class="form-control"
                       type="number"
                       placeholder="Enter credit hours" />

                <span asp-validation-for="CreditHours"
                      class="text-danger">
                </span>

            </div>

            <!-- Fee -->
            <div class="mb-3">

                <label asp-for="Fee" class="form-label">
                    Fee
                </label>

                <input asp-for="Fee"
                       class="form-control"
                       type="number"
                       step="0.01"
                       placeholder="Enter course fee" />

                <span asp-validation-for="Fee"
                      class="text-danger">
                </span>

            </div>

            <!-- Department -->
            <div class="mb-3">

                <label asp-for="DepartmentId" class="form-label">
                    Department
                </label>

                <select asp-for="DepartmentId"
                        class="form-select"
                        asp-items="ViewBag.Departments">

                    <option value="">
                        -- Select Department --
                    </option>

                </select>

                <span asp-validation-for="DepartmentId"
                      class="text-danger">
                </span>

            </div>

            <!-- Buttons -->
            <div class="text-end">

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-circle"></i>
                    Save Course

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}