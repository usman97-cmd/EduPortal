@model Student_Mangement_System.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<style>
    .profile-wrapper {
        max-width: 950px;
        margin: 0 auto;
    }

    .profile-card {
        background: #1f2327;
        border: 1px solid #343a40;
        border-radius: 15px;
        overflow: hidden;
    }

    .profile-header {
        background: linear-gradient(135deg, #212529, #343a40);
        padding: 35px;
        position: relative;
    }

    .profile-image {
        width: 125px;
        height: 125px;
        object-fit: cover;
        border: 4px solid #ffffff;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
    }

    .profile-name {
        color: #ffffff;
        font-size: 28px;
        font-weight: 700;
    }

    .profile-role {
        color: #adb5bd;
        font-size: 15px;
    }

    .profile-body {
        padding: 30px;
    }

    .info-box {
        background: #292e33;
        border: 1px solid #343a40;
        border-radius: 10px;
        padding: 18px;
        height: 100%;
    }

    .info-icon {
        width: 42px;
        height: 42px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        background: rgba(13, 110, 253, 0.15);
        color: #0d6efd;
    }

    .info-label {
        color: #6c757d;
        font-size: 13px;
        margin-bottom: 4px;
    }

    .info-value {
        color: #ffffff;
        font-weight: 600;
        word-break: break-word;
    }

    .role-badge {
        background: rgba(25, 135, 84, 0.15);
        color: #20c997;
        border: 1px solid rgba(25, 135, 84, 0.3);
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .profile-title {
        color: #ffffff;
        font-weight: 700;
    }

    .profile-subtitle {
        color: #6c757d;
        font-size: 14px;
    }
</style>


<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-white mb-1">
                My Profile
            </h2>

            <p class="profile-subtitle mb-0">
                Manage and view your profile information
            </p>

        </div>

    </div>


    <div class="profile-wrapper">

        <div class="card profile-card shadow">

            <div class="profile-header">

                <div class="d-flex align-items-center gap-4">

                    <img src="@Model.ProfileImage"
                         class="profile-image rounded-circle"
                         alt="Profile Image">

                    <div>

                        <div class="profile-name">
                            @Model.Name
                        </div>

                        <div class="profile-role mb-3">
                            @Model.Role
                        </div>

                        <span class="role-badge">

                            <i class="bi bi-check-circle me-1"></i>

                            Active

                        </span>

                    </div>

                </div>

            </div>

            <div class="profile-body">


                <div class="mb-4">

                    <h4 class="profile-title mb-1">
                        Personal Information
                    </h4>

                    <p class="profile-subtitle">
                        Your basic account information
                    </p>

                </div>


                <div class="row g-4">

                    <div class="col-md-6">

                        <div class="info-box">

                            <div class="d-flex align-items-center gap-3">

                                <div class="info-icon">

                                    <i class="bi bi-person-fill"></i>

                                </div>

                                <div>

                                    <div class="info-label">
                                        Full Name
                                    </div>

                                    <div class="info-value">
                                        @Model.Name
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="info-box">

                            <div class="d-flex align-items-center gap-3">

                                <div class="info-icon">

                                    <i class="bi bi-envelope-fill"></i>

                                </div>

                                <div>

                                    <div class="info-label">
                                        Email Address
                                    </div>

                                    <div class="info-value">
                                        @Model.Email
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="info-box">

                            <div class="d-flex align-items-center gap-3">

                                <div class="info-icon">

                                    <i class="bi bi-telephone-fill"></i>

                                </div>

                                <div>

                                    <div class="info-label">
                                        Phone Number
                                    </div>

                                    <div class="info-value">
                                        @Model.Phone
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="info-box">

                            <div class="d-flex align-items-center gap-3">

                                <div class="info-icon">

                                    <i class="bi bi-shield-check"></i>

                                </div>

                                <div>

                                    <div class="info-label">
                                        Role
                                    </div>

                                    <div class="info-value">
                                        @Model.Role
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                </div>

                <div class="mt-4">

                    <div class="info-box">

                        <div class="d-flex align-items-center gap-3">

                            <div class="info-icon">

                                <i class="bi bi-person-check-fill"></i>

                            </div>

                            <div>

                                <div class="info-label">
                                    Account Status
                                </div>

                                <div class="info-value">

                                    <span class="text-success">

                                        <i class="bi bi-circle-fill"
                                           style="font-size: 8px;"></i>

                                        Active Account

                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


            </div>

        </div>

    </div>

</div>