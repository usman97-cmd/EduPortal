@model Student_Mangement_System.Models.Result

@{
    ViewData["Title"] = "Create Result";
}

<div class="row mb-3">

    <div class="col-sm-6">
        <h3 class="m-0">Create Result</h3>
    </div>

    <div class="col-sm-6 text-end">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

</div>


<div class="card shadow-sm">

    <div class="card-header">
        <h3 class="card-title">
            Result Information
        </h3>
    </div>

    <div class="card-body">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- Student -->

            <div class="mb-3">

                <label asp-for="StudentId"
                       class="form-label">
                    Student
                </label>

                <select asp-for="StudentId"
                        class="form-select"
                        asp-items="ViewBag.Student">

                    <option value="">
                        -- Select Student --
                    </option>

                </select>

                <span asp-validation-for="StudentId"
                      class="text-danger">
                </span>

            </div>


            <!-- Course -->

            <div class="mb-3">

                <label asp-for="CourseId"
                       class="form-label">
                    Course
                </label>

                <select asp-for="CourseId"
                        class="form-select"
                        asp-items="ViewBag.Course">

                    <option value="">
                        -- Select Course --
                    </option>

                </select>

                <span asp-validation-for="CourseId"
                      class="text-danger">
                </span>

            </div>


            <!-- Mid Marks -->

            <div class="mb-3">

                <label asp-for="MidMarks"
                       class="form-label">
                    Mid Marks
                </label>

                <input asp-for="MidMarks"
                       class="form-control"
                       type="number"
                       step="0.01"
                       placeholder="Enter mid marks" />

                <span asp-validation-for="MidMarks"
                      class="text-danger">
                </span>

            </div>


            <!-- Final Marks -->

            <div class="mb-3">

                <label asp-for="FinalMarks"
                       class="form-label">
                    Final Marks
                </label>

                <input asp-for="FinalMarks"
                       class="form-control"
                       type="number"
                       step="0.01"
                       placeholder="Enter final marks" />

                <span asp-validation-for="FinalMarks"
                      class="text-danger">
                </span>

            </div>


            <!-- Total Marks -->

            <div class="mb-3">

                <label asp-for="TotalMarks"
                       class="form-label">
                    Total Marks
                </label>

                <input asp-for="TotalMarks"
                       class="form-control"
                       type="number"
                       step="0.01"
                       placeholder="Total Marks"
                       readonly/>

                <span asp-validation-for="TotalMarks"
                      class="text-danger">
                </span>

            </div>


            <!-- Grade -->

            <div class="mb-3">

                <label asp-for="Grade"
                       class="form-label">
                    Grade
                </label>

                <input asp-for="Grade"
                       class="form-control"
                       placeholder="Grade"
                       readonly />

                <span asp-validation-for="Grade"
                      class="text-danger">
                </span>

            </div>


            <div class="text-end">

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-circle"></i>
                    Save Result

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <script>
        const midMarks = document.getElementById("MidMarks");
        const finalMarks = document.getElementById("FinalMarks");
        const totalMarks = document.getElementById("TotalMarks");
        const grade = document.getElementById("Grade");

        function calculateResult() {

            const total =
                Number(midMarks.value) + Number(finalMarks.value);

            totalMarks.value = total;

            if (total >= 90) {
                grade.value = "A+";
            }
            else if (total >= 80) {
                grade.value = "A";
            }
            else if (total >= 70) {
                grade.value = "B";
            }
            else if (total >= 60) {
                grade.value = "C";
            }
            else if (total >= 50) {
                grade.value = "D";
            }
            else {
                grade.value = "F";
            }
        }

        midMarks.addEventListener("input", calculateResult);
        finalMarks.addEventListener("input", calculateResult);
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}